<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_expense_return_reason_wizard_form" model="ir.ui.view">
        <field name="name">expense.return.reason.wizard.form</field>
        <field name="model">expense.return.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Expense Sheet">
                <group>
                    <field name="sheet_id" readonly="1"/>
                    <field name="returned_tier"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
